# ==========================================
# EcoSmart Campus - Environment Variables
# ==========================================

# Application
APP_NAME="EcoSmart Campus API"
APP_ENV=development
DEBUG=true
PORT=8000

# Security / JWT (Sprint 1 - T03)
SECRET_KEY="supersecret_ecosmart_jwt_key_change_in_production_!"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# PostgreSQL / TimescaleDB (Sprint 1 - T05)
POSTGRES_USER=ecosmart
POSTGRES_PASSWORD=ecosmart_secret
POSTGRES_DB=ecosmart_db
POSTGRES_HOST=timescaledb
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://ecosmart:ecosmart_secret@localhost:5432/ecosmart_db
SYNC_DATABASE_URL=postgresql://ecosmart:ecosmart_secret@localhost:5432/ecosmart_db

# MQTT Broker Mosquitto (Sprint 1 - T04, T05)
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_BROKER_WS_PORT=9001
MQTT_KEEPALIVE=60

# LangChain / Assistant (Sprint 1 - T09)
# Format: fournisseur:modèle (ex: openai:gpt-4o-mini ou ollama:llama3)
LLM_MODEL="mock:demo"
OPENAI_API_KEY=""
OLLAMA_BASE_URL="http://localhost:11434"
